name: "road_seg_unet"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 3, 256, 256 ]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 1, 1, 256, 256 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
