# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Node
node_modules/
viewer/dist/

# Secrets -- holds NVIDIA_API_KEY
.env

# Pipeline output. Regenerate with:
#   uv run pos run --video samples/road/road.mp4 --gpx samples/road/track.gpx \
#       --truth samples/road/truth.json --out run
run/
runs/

# Intermediate render frames from the sample generator
samples/**/frames_src/

# Video, anywhere. The pipeline is run on new footage each time, so no clip in
# this tree is a source artifact: they are all inputs or renders. `pos video`
# writes review.mp4 into a run, and at ~330 KB per 1080p frame those add up fast.
*.mp4
*.mov
*.mkv
*.avi
*.webm

# NOTE: samples/ is still COMMITTED, minus the media. The GPX track, truth.json
# and objects.json are small text fixtures and they matter: truth.json is the
# only ground truth in the repo, so scripts/score_perception.py is the only place
# a real precision/recall claim can be made. The synthetic sample VIDEO is not
# committed because scripts/make_sample.py regenerates it deterministically --
# run that first on a fresh clone, then scripts/verify_sample.py.

# TypeScript incremental build cache. Regenerated by every `npm run build`, so
# committing it means a spurious diff on each one.
viewer/tsconfig.tsbuildinfo

# Uploaded source media and studio job state. `uploads/` is 557 MB and
# `road_videos/` 1.4 GB of real survey footage. Git stores binaries whole and
# forever, so a single `git add -A` would write ~2 GB into history that no clone
# can ever shed. Both are INPUTS and are reproducible by re-uploading.
uploads/
road_videos/

# Exported deliverables sitting at the repo root. Regenerate with `pos kml` /
# `pos report` from the run they came from -- the run is the source of truth.
/*.kmz
/*.pdf

# Agent/editor local state, machine-specific by definition.
.claude/settings.local.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Screenshots and browser-automation scratch
*.png
.playwright-mcp/
